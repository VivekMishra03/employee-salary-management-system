# Copy this file to .env (gitignored) and fill in real values, OR export these directly in your
# shell. Never put real values in this file -- it is committed, and .gitignore only protects .env,
# not .env.example.
#
# backend/src/main/resources/application.yml reads every one of these from the environment with an
# empty, non-functional default (NFR-4/NFR-6): if any is unset, the application refuses to start
# with a clear error rather than silently connecting to nothing.

# --- Database (Neon in production; see docs/adr/0007) ---
# Get this from your Neon project dashboard -> Connection string. Split the pieces: DATABASE_URL is
# the jdbc:postgresql://host/db?params part only, credentials go in the two variables below --
# never embed a username:password in DATABASE_URL itself.
DATABASE_URL=jdbc:postgresql://<your-neon-host>/<your-db>?sslmode=require&channel_binding=require
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Authentication (ADR-0009) ---
# HS256 signing key, at least 32 characters. NO default: the application refuses to start without it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Optional; token lifetime in minutes (defaults to 60).
JWT_EXPIRY_MINUTES=60

# --- Seed script only (scripts/seed.js; the API does not read this) ---
# Password for the HR Manager account the seed creates. NO default. At least 12 characters (72 bytes
# at most), choose your own, never commit it. Also used by: node scripts/seed.js --reset-hr-password
SEED_HR_PASSWORD=

# --- Server ---
# Optional locally; Render supplies this automatically at deploy time (M9).
PORT=8080


